# Local dev database — matches docker-compose.yml (postgres on host port 5436).
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5436/payload
PAYLOAD_SECRET=YOUR_SECRET_HERE

SERVER_URL=http://localhost:3005
CORS_ORIGINS=http://localhost:3000

# Subpath the CMS is served under (empty when served at the domain root).
# Sets Next.js basePath (+ NEXT_PUBLIC_BASE_PATH). basePath is baked at build
# time — pass it as the NEXT_BASE_PATH build-arg for the Docker image; `pnpm dev`
# reads this .env value. When set, also include the subpath in SERVER_URL.
# Production is served at /_services/cms (see .github/workflows/build-image.yml).
NEXT_BASE_PATH=

# Shared wsj27-auth service OIDC discovery endpoint (used to verify its tokens).
# The service mints its own tokens in Keycloak's claim shape; the CMS reads the
# wsj27-cms client roles (admin/editor) from resource_access.
AUTH_DISCOVERY_URL=https://campfire.wsj27.scouterna.net/api/auth/.well-known/openid-configuration
